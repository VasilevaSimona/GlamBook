@model IEnumerable<GlamBook.Application.DTOs.CategoryDto>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

    :root {
        --pink: #e91e8c;
        --pink-mid: #f48cb6;
        --dark: #1a0a12;
        --cream: #fdf7f4;
        --text: #2d1a24;
    }

    body {
        font-family: 'Montserrat', sans-serif;
        background: var(--cream);
    }

    /* ── HERO ── */
    .cat-hero {
        padding: 80px 48px 60px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        position: relative;
    }

        .cat-hero::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 48px;
            right: 48px;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--pink-mid), transparent);
        }

        .cat-hero h1 {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(52px, 7vw, 96px);
            font-weight: 300;
            line-height: 0.9;
            letter-spacing: -1px;
            color: var(--text);
        }

            .cat-hero h1 em {
                font-style: italic;
                color: var(--pink);
            }

    .cat-hero-sub {
        margin-top: 20px;
        font-size: 11px;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #9a7080;
        font-weight: 500;
    }

    .cat-hero-stat {
        text-align: right;
        opacity: .45;
    }

        .cat-hero-stat .num {
            font-family: 'Cormorant Garamond', serif;
            font-size: 72px;
            font-weight: 300;
            line-height: 1;
            color: var(--text);
        }

        .cat-hero-stat .lbl {
            font-size: 10px;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #9a7080;
        }

    /* ── FILTER BAR ── */
    .filter-bar {
        padding: 32px 48px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .filter-label {
        font-size: 10px;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #9a7080;
        margin-right: 8px;
    }

    .filter-btn {
        padding: 8px 20px;
        border-radius: 100px;
        border: 1px solid rgba(233, 30, 140, 0.3);
        background: transparent;
        font-family: 'Montserrat', sans-serif;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--text);
        cursor: pointer;
        transition: all .3s;
    }

        .filter-btn:hover,
        .filter-btn.active {
            background: var(--pink);
            border-color: var(--pink);
            color: #fff;
        }

    /* ── GRID ── */
    .cat-grid {
        padding: 0 48px 80px;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

        /* First card spans two rows */
        .cat-grid .cat-card-wrap:first-child {
            grid-column: 1 / 2;
            grid-row: 1 / 3;
        }

    /* ── CARD ── */
    .cat-card-wrap {
        animation: fadeUp .7s ease both;
    }

        .cat-card-wrap:nth-child(1) {
            animation-delay: .10s;
        }

        .cat-card-wrap:nth-child(2) {
            animation-delay: .20s;
        }

        .cat-card-wrap:nth-child(3) {
            animation-delay: .30s;
        }

        .cat-card-wrap:nth-child(4) {
            animation-delay: .40s;
        }

        .cat-card-wrap:nth-child(5) {
            animation-delay: .45s;
        }

        .cat-card-wrap:nth-child(6) {
            animation-delay: .50s;
        }

    .cat-card {
        position: relative;
        display: block;
        width: 100%;
        height: 100%;
        min-height: 320px;
        border-radius: 20px;
        overflow: hidden;
        text-decoration: none;
        cursor: pointer;
    }

    .cat-card-wrap:first-child .cat-card {
        min-height: 660px;
    }

    /* Cycle through gradient palettes */
    .cat-card-wrap:nth-child(6n+1) .cat-bg {
        background: linear-gradient(145deg, #fce4ec 0%, #f48fb1 40%, #e91e8c 100%);
    }

    .cat-card-wrap:nth-child(6n+2) .cat-bg {
        background: linear-gradient(145deg, #fff3e0 0%, #ffcc80 40%, #ff9800 80%, #e65100 100%);
    }

    .cat-card-wrap:nth-child(6n+3) .cat-bg {
        background: linear-gradient(145deg, #e8f5e9 0%, #a5d6a7 40%, #43a047 100%);
    }

    .cat-card-wrap:nth-child(6n+4) .cat-bg {
        background: linear-gradient(145deg, #e3f2fd 0%, #90caf9 40%, #1e88e5 100%);
    }

    .cat-card-wrap:nth-child(6n+5) .cat-bg {
        background: linear-gradient(145deg, #f3e5f5 0%, #ce93d8 40%, #8e24aa 100%);
    }

    .cat-card-wrap:nth-child(6n+6) .cat-bg {
        background: linear-gradient(145deg, #e0f2f1 0%, #80cbc4 40%, #00897b 100%);
    }

    .cat-bg {
        position: absolute;
        inset: 0;
        transition: transform .6s cubic-bezier(.25,.46,.45,.94);
    }

    .cat-card:hover .cat-bg {
        transform: scale(1.05);
    }

    /* Decorative blobs */
    .cat-blob {
        position: absolute;
        border-radius: 50%;
        opacity: .35;
        transition: transform .6s ease;
        pointer-events: none;
    }

    .cat-card:hover .cat-blob {
        transform: scale(1.15) rotate(15deg);
    }

    .cat-blob-1 {
        width: 300px;
        height: 300px;
        bottom: -80px;
        right: -80px;
        background: rgba(255,255,255,.5);
    }

    .cat-blob-2 {
        width: 150px;
        height: 150px;
        top: 30px;
        left: -30px;
        background: rgba(255,255,255,.3);
    }

    .cat-blob-3 {
        width: 80px;
        height: 80px;
        top: 50%;
        right: 40px;
        background: rgba(255,255,255,.4);
    }

    /* Content overlay */
    .cat-content {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 36px;
    }

    .cat-tag {
        display: inline-block;
        background: rgba(255,255,255,.35);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,.5);
        border-radius: 100px;
        padding: 4px 14px;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: rgba(255,255,255,.9);
        margin-bottom: 16px;
        width: fit-content;
    }

    .cat-name {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(38px, 4vw, 58px);
        font-weight: 400;
        color: #fff;
        line-height: 1;
        text-shadow: 0 2px 20px rgba(0,0,0,.15);
        margin-bottom: 12px;
    }

    .cat-card-wrap:first-child .cat-name {
        font-size: clamp(52px, 5vw, 80px);
    }

    .cat-explore {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #fff;
        transition: gap .3s;
    }

    .cat-card:hover .cat-explore {
        gap: 16px;
    }

    .cat-arrow {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255,255,255,.25);
        border: 1px solid rgba(255,255,255,.4);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background .3s, transform .3s;
        flex-shrink: 0;
    }

    .cat-card:hover .cat-arrow {
        background: rgba(255,255,255,.45);
        transform: rotate(45deg);
    }

    .cat-index {
        position: absolute;
        top: 28px;
        right: 28px;
        z-index: 2;
        font-family: 'Cormorant Garamond', serif;
        font-size: 13px;
        color: rgba(255,255,255,.6);
        letter-spacing: 1px;
    }

    /* ── CTA STRIP ── */
    .cta-strip {
        margin: 0 48px 80px;
        background: var(--dark);
        border-radius: 20px;
        padding: 48px 60px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
    }

        .cta-strip::before {
            content: '';
            position: absolute;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(233,30,140,.3) 0%, transparent 70%);
            right: -100px;
            top: -150px;
            pointer-events: none;
        }

        .cta-strip h2 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 42px;
            font-weight: 300;
            color: #fff;
            line-height: 1.1;
            margin-bottom: 8px;
        }

            .cta-strip h2 em {
                font-style: italic;
                color: var(--pink-mid);
            }

        .cta-strip p {
            font-size: 12px;
            color: rgba(255,255,255,.45);
            letter-spacing: 1px;
        }

    .cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        background: var(--pink);
        color: #fff;
        padding: 16px 36px;
        border-radius: 100px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        text-decoration: none;
        transition: all .3s;
        white-space: nowrap;
    }

        .cta-btn:hover {
            background: #ff4db0;
            transform: translateY(-2px);
            box-shadow: 0 16px 40px rgba(233,30,140,.4);
            color: #fff;
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<!-- HERO -->
<section class="cat-hero">
    <div>
        <h1>Our <em>Beauty</em><br>Categories</h1>
        <p class="cat-hero-sub">Find your perfect service</p>
    </div>
    <div class="cat-hero-stat">
        <div class="num">@Model.Count()</div>
        <div class="lbl">Service areas</div>
    </div>
</section>

<!-- FILTER BAR -->
<div class="filter-bar">
    <span class="filter-label">Filter</span>
    <button class="filter-btn active">All</button>
    <button class="filter-btn">Most Popular</button>
    <button class="filter-btn">Near You</button>
    <button class="filter-btn">New</button>
</div>

<!-- CATEGORIES GRID -->
<section class="cat-grid">
    @{
        var tags = new[] { "Most Booked", "Trending", "Classic", "Professional", "New", "Popular" };
        int i = 0;
        int total = Model.Count();
    }

    @foreach (var c in Model)
    {
        <div class="cat-card-wrap">
            <a asp-controller="Salons"
               asp-action="Index"
               asp-route-categoryId="@c.Id"
               class="cat-card">

                <div class="cat-bg"></div>
                <div class="cat-blob cat-blob-1"></div>
                <div class="cat-blob cat-blob-2"></div>
                <div class="cat-blob cat-blob-3"></div>

                <span class="cat-index">@((i + 1).ToString("D2")) / @total.ToString("D2")</span>

                <div class="cat-content">
                    <span class="cat-tag">@tags[i % tags.Length]</span>
                    <h2 class="cat-name">@c.Name</h2>
                    <div class="cat-explore">
                        Explore
                        <span class="cat-arrow">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="white" stroke-width="1.5" stroke-linecap="round" />
                            </svg>
                        </span>
                    </div>
                </div>
            </a>
        </div>
        i++;
    }
</section>

<!-- CTA STRIP -->
<div class="cta-strip">
    <div>
        <h2>Ready to book your<br><em>perfect moment?</em></h2>
        <p>Hundreds of salons available near you</p>
    </div>
    <a asp-controller="Salons" asp-action="Index" class="cta-btn">
        Book Now
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M2 12L12 2M12 2H5M12 2V9" stroke="white" stroke-width="1.5" stroke-linecap="round" />
        </svg>
    </a>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
            });
        });
    </script>
}