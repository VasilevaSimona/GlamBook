@{
    var isHomePage =
        ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
        ViewContext.RouteData.Values["action"]?.ToString() == "Index";

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GlamBook</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background: #fdf7f4;
            color: #2d1a24;
            margin: 0;
        }

        /* ── NAV BASE ── */
        .glambook-nav {
            left: 0;
            right: 0;
            top: 0;
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 48px;
            height: 70px;
            transition: background 0.3s, border-color 0.3s, backdrop-filter 0.3s;
        }

            /* Overlay mode (home page) — transparent over hero image */
            .glambook-nav.nav-overlay {
                position: absolute;
                background: transparent;
                border-bottom: 1px solid rgba(255, 255, 255, 0.15);
            }

            /* Normal mode (all other pages) — frosted cream */
            .glambook-nav.nav-solid {
                position: sticky;
                background: rgba(253, 247, 244, 0.92);
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                border-bottom: 1px solid rgba(233, 30, 140, 0.12);
            }

            /* ── NAV LINKS ── */
            .glambook-nav .nav-links {
                flex: 1;
                display: flex;
                gap: 36px;
                list-style: none;
                margin: 0;
                padding: 0;
            }

                .glambook-nav .nav-links a {
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 2px;
                    text-transform: uppercase;
                    text-decoration: none;
                    transition: color 0.3s;
                    position: relative;
                    padding-bottom: 4px;
                }

                    /* Underline active indicator */
                    .glambook-nav .nav-links a::after {
                        content: '';
                        position: absolute;
                        bottom: 0;
                        left: 0;
                        right: 0;
                        height: 1px;
                        background: currentColor;
                        transform: scaleX(0);
                        transform-origin: left;
                        transition: transform 0.3s ease;
                    }

                    .glambook-nav .nav-links a:hover::after,
                    .glambook-nav .nav-links a.nav-active::after {
                        transform: scaleX(1);
                    }

        /* Overlay link colours */
        .nav-overlay .nav-links a {
            color: rgba(255, 255, 255, 0.85);
        }

            .nav-overlay .nav-links a:hover,
            .nav-overlay .nav-links a.nav-active {
                color: #fff;
            }

        /* Solid link colours */
        .nav-solid .nav-links a {
            color: #2d1a24;
        }

            .nav-solid .nav-links a:hover {
                color: #e91e8c;
            }

            .nav-solid .nav-links a.nav-active {
                color: #e91e8c;
            }

        /* ── LOGO ── */
        .glambook-nav .nav-brand {
            font-family: 'Montserrat', sans-serif;
            font-size: 20px;
            font-weight: 700;
            letter-spacing: 4px;
            text-decoration: none;
            transition: color 0.3s;
        }

        .nav-overlay .nav-brand {
            color: #fff;
        }

        .nav-solid .nav-brand {
            color: #2d1a24;
        }

        /* ── RIGHT AUTH ── */
        .glambook-nav .nav-auth {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 16px;
            font-size: 11px;
            letter-spacing: 1px;
            justify-content: flex-end;
        }

        .nav-overlay .nav-auth,
        .nav-overlay .nav-auth span {
            color: rgba(255, 255, 255, 0.85);
        }

        .nav-solid .nav-auth,
        .nav-solid .nav-auth span {
            color: #2d1a24;
        }

        .nav-auth .auth-cta {
            font-weight: 700;
            letter-spacing: 2px;
            font-size: 11px;
            text-decoration: none;
            transition: color 0.3s;
        }

        .nav-overlay .auth-cta {
            color: #fff;
        }

            .nav-overlay .auth-cta:hover {
                color: #fce4f3;
            }

        .nav-solid .auth-cta {
            color: #e91e8c;
        }

            .nav-solid .auth-cta:hover {
                color: #c0156e;
            }

        .nav-auth .auth-divider {
            opacity: 0.4;
            font-weight: 300;
        }

        /* ── PAGE CONTENT OFFSET ── */
        /* Only non-home pages need top padding since nav is sticky there */
        .page-wrapper {
            min-height: calc(100vh - 70px);
        }

        /* ── FOOTER ── */
        /* ── FOOTER ── */
        .footer {
            background-color: #0d0508;
            color: #ccc;
            padding: 0;
            margin-top: 0;
            position: relative;
        }

        .footer-top-bar {
            background: linear-gradient(90deg, transparent, #e91e8c, transparent);
            height: 1px;
            width: 100%;
        }

        .footer-inner {
            padding: 60px 0 28px;
        }

        .footer-logo {
            color: #fff;
            font-weight: 700;
            font-size: 18px;
            letter-spacing: 4px;
            font-family: 'Montserrat', sans-serif;
        }

        .footer-tagline {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 12px;
            background: rgba(233,30,140,0.08);
            border: 1px solid rgba(233,30,140,0.2);
            border-radius: 100px;
            padding: 4px 14px;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #f48cb6;
        }

        .footer-text {
            font-size: 12px;
            line-height: 1.8;
            max-width: 260px;
            color: rgba(255,255,255,0.35);
            margin-top: 14px;
        }

        .footer h6 {
            color: rgba(255,255,255,0.3);
            font-weight: 700;
            font-size: 9px;
            letter-spacing: 4px;
            text-transform: uppercase;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(233,30,140,0.15);
        }

        .footer-links {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .footer-links li {
                margin-bottom: 12px;
            }

            .footer-links a {
                color: rgba(255,255,255,0.45);
                text-decoration: none;
                font-size: 12px;
                transition: color 0.3s;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

                .footer-links a::before {
                    content: '';
                    display: block;
                    width: 0;
                    height: 1px;
                    background: #e91e8c;
                    transition: width 0.3s;
                }

                .footer-links a:hover {
                    color: #f48cb6;
                }

                    .footer-links a:hover::before {
                        width: 12px;
                    }

        .footer hr {
            border-color: rgba(255,255,255,0.06);
            margin: 40px 0 20px;
        }

        .footer-bottom {
            font-size: 10px;
            color: rgba(255,255,255,0.2);
            letter-spacing: 1.5px;
            text-transform: uppercase;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .footer-bottom-heart {
            color: #e91e8c;
            font-size: 12px;
        }
    </style>
</head>
<body>

    <!-- NAV -->
    <nav class="glambook-nav @(isHomePage ? "nav-overlay" : "nav-solid")">

        <!-- LEFT: links -->
        <ul class="nav-links">
            <li>
                <a asp-area="" asp-controller="Home" asp-action="Index"
                   class="@(currentController == "Home" && currentAction == "Index" ? "nav-active" : "")">
                    Home
                </a>
            </li>
            <li>
                <a asp-area="" asp-controller="Categories" asp-action="Index"
                   class="@(currentController == "Categories" ? "nav-active" : "")">
                    Categories
                </a>
            </li>
            <li>
                <a asp-area="" asp-controller="Salons" asp-action="Index"
                   class="@(currentController == "Salons" ? "nav-active" : "")">
                    Salons
                </a>
            </li>
            <li>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-area="Admin" asp-controller="Appointments" asp-action="Index"
                       class="@(currentController == "Appointments" ? "nav-active" : "")">
                        Appointments
                    </a>
                }
                else if (User.IsInRole("Manager"))
                {
                    <a asp-area="Manager" asp-controller="Appointments" asp-action="Index"
                       class="@(currentController == "Appointments" ? "nav-active" : "")">
                        Appointments
                    </a>
                }
                else
                {
                    <a asp-area="" asp-controller="Appointment" asp-action="My"
                       class="@(currentController == "Appointment" ? "nav-active" : "")">
                        Appointments
                    </a>
                }
            </li>
        </ul>

        <!-- CENTER: logo -->
        <a asp-controller="Home" asp-action="Index" class="nav-brand">GLAMBOOK</a>

        <!-- RIGHT: auth -->
        <div class="nav-auth">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <span>Hello, @User.Identity.Name!</span>
                <a asp-area="Identity" asp-page="/Account/Logout" class="auth-cta">Logout</a>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Register" class="auth-cta">Register</a>
                <span class="auth-divider">|</span>
                <a asp-area="Identity" asp-page="/Account/Login" class="auth-cta">Login</a>
            }
        </div>

    </nav>

    <!-- PAGE CONTENT -->
    <div class="page-wrapper">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="footer-top-bar"></div>
        <div class="footer-inner">
            <div class="container">
                <div class="row">
                    <div class="col-md-4 mb-4">
                        <div class="footer-logo">GLAMBOOK</div>
                        <div class="footer-tagline">Beauty Made Simple</div>
                        <p class="footer-text">
                            Your trusted platform for discovering beauty salons
                            and booking appointments with ease.
                        </p>
                    </div>

                    <div class="col-md-4 mb-4">
                        <h6>Explore</h6>
                        <ul class="footer-links">
                            <li><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                            <li><a asp-area="" asp-controller="Categories" asp-action="Index">Categories</a></li>
                            <li><a asp-area="" asp-controller="Salons" asp-action="Index">Salons</a></li>
                            <li><a asp-area="" asp-controller="Appointment" asp-action="My">My Appointments</a></li>
                        </ul>
                    </div>

                    <div class="col-md-4 mb-4">
                        <h6>Account</h6>
                        <ul class="footer-links">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <li><a asp-area="Identity" asp-page="/Account/Manage/Index">Profile</a></li>
                                <li><a asp-area="Identity" asp-page="/Account/Logout">Logout</a></li>
                            }
                            else
                            {
                                <li><a asp-area="Identity" asp-page="/Account/Login">Login</a></li>
                                <li><a asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                            }
                        </ul>
                    </div>
                </div>

                <hr />

                <div class="footer-bottom">
                    <span>© @DateTime.Now.Year GlamBook. All rights reserved.</span>
                    <span>Made with <span class="footer-bottom-heart">♥</span> for beauty</span>
                </div>
            </div>
        </div>
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>