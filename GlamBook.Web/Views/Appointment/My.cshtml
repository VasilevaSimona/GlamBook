@model IEnumerable<GlamBook.Application.DTOs.AppointmentDto>

<style>
    .appt-hero {
        padding: 80px 48px 60px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        position: relative;
    }

        .appt-hero::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 48px;
            right: 48px;
            height: 1px;
            background: linear-gradient(90deg, transparent, #f48cb6, transparent);
        }

        .appt-hero h1 {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(52px, 7vw, 96px);
            font-weight: 300;
            line-height: 0.9;
            letter-spacing: -1px;
            color: #2d1a24;
        }

            .appt-hero h1 em {
                font-style: italic;
                color: #e91e8c;
            }

    .appt-hero-sub {
        margin-top: 20px;
        font-size: 11px;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #9a7080;
        font-weight: 500;
    }

    .appt-hero-stat {
        text-align: right;
        opacity: .45;
    }

        .appt-hero-stat .num {
            font-family: 'Cormorant Garamond', serif;
            font-size: 72px;
            font-weight: 300;
            line-height: 1;
            color: #2d1a24;
        }

        .appt-hero-stat .lbl {
            font-size: 10px;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #9a7080;
        }

    .appt-grid {
        padding: 52px 48px 80px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .appt-card {
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(45, 26, 36, 0.06);
        display: flex;
        flex-direction: column;
        animation: fadeUp 0.6s ease both;
        position: relative;
        transition: transform 0.35s, box-shadow 0.35s;
    }

        .appt-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 40px rgba(233, 30, 140, 0.1);
        }

        .appt-card:nth-child(1) {
            animation-delay: .05s;
        }

        .appt-card:nth-child(2) {
            animation-delay: .10s;
        }

        .appt-card:nth-child(3) {
            animation-delay: .15s;
        }

        .appt-card:nth-child(4) {
            animation-delay: .20s;
        }

        .appt-card:nth-child(5) {
            animation-delay: .25s;
        }

        .appt-card:nth-child(6) {
            animation-delay: .30s;
        }

    .appt-card-bar {
        height: 4px;
        width: 100%;
    }

    .bar-pending {
        background: linear-gradient(90deg, #fff3e0, #ff9800);
    }

    .bar-confirmed {
        background: linear-gradient(90deg, #e8f5e9, #43a047);
    }

    .bar-cancelled {
        background: linear-gradient(90deg, #fce4ec, #e91e8c);
    }

    .bar-completed {
        background: linear-gradient(90deg, #e3f2fd, #1e88e5);
    }

    .appt-body {
        padding: 28px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .appt-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 100px;
        padding: 4px 12px;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        width: fit-content;
        margin-bottom: 16px;
    }

    .status-pending {
        background: rgba(255,152,0,.1);
        color: #e65100;
        border: 1px solid rgba(255,152,0,.3);
    }

    .status-confirmed {
        background: rgba(67,160,71,.1);
        color: #2e7d32;
        border: 1px solid rgba(67,160,71,.3);
    }

    .status-cancelled {
        background: rgba(233,30,140,.08);
        color: #c0156e;
        border: 1px solid rgba(233,30,140,.2);
    }

    .status-completed {
        background: rgba(30,136,229,.1);
        color: #1565c0;
        border: 1px solid rgba(30,136,229,.3);
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .appt-service-name {
        font-family: 'Cormorant Garamond', serif;
        font-size: 28px;
        font-weight: 400;
        color: #2d1a24;
        line-height: 1.1;
        margin-bottom: 6px;
    }

    .appt-salon {
        font-size: 12px;
        color: #9a7080;
        margin-bottom: 0;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .appt-divider {
        height: 1px;
        background: linear-gradient(90deg, #fce4f3, transparent);
        margin: 18px 0;
    }

    .appt-datetime {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .appt-date-box {
        background: #fdf7f4;
        border: 1px solid rgba(233, 30, 140, 0.15);
        border-radius: 12px;
        padding: 10px 14px;
        text-align: center;
        min-width: 56px;
    }

        .appt-date-box .day {
            font-family: 'Cormorant Garamond', serif;
            font-size: 28px;
            font-weight: 400;
            color: #e91e8c;
            line-height: 1;
        }

        .appt-date-box .month {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #9a7080;
        }

    .appt-time-info .time {
        font-size: 18px;
        font-weight: 600;
        color: #2d1a24;
        line-height: 1;
        margin-bottom: 4px;
    }

    .appt-time-info .weekday {
        font-size: 11px;
        color: #9a7080;
        letter-spacing: 1px;
    }

    .appt-cancel-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 20px;
        border-radius: 100px;
        border: 1px solid rgba(233, 30, 140, 0.3);
        background: transparent;
        font-family: 'Montserrat', sans-serif;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #e91e8c;
        text-decoration: none;
        transition: all 0.3s;
        margin-top: auto;
        width: fit-content;
    }

        .appt-cancel-btn:hover {
            background: #e91e8c;
            border-color: #e91e8c;
            color: #fff;
        }

    .appt-empty {
        grid-column: 1 / -1;
        text-align: center;
        padding: 80px 20px;
    }

    .appt-empty-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: rgba(233,30,140,0.08);
        border: 1px solid rgba(233,30,140,0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
    }

    .appt-empty h3 {
        font-family: 'Cormorant Garamond', serif;
        font-size: 32px;
        font-weight: 300;
        font-style: italic;
        color: #2d1a24;
        margin-bottom: 8px;
    }

    .appt-empty p {
        font-size: 12px;
        color: #9a7080;
        letter-spacing: 1px;
        margin-bottom: 28px;
    }

    .appt-empty-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #e91e8c;
        color: #fff;
        padding: 12px 28px;
        border-radius: 100px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        text-decoration: none;
        transition: all 0.3s;
    }

        .appt-empty-btn:hover {
            background: #ff4db0;
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(233,30,140,0.35);
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(24px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 991px) {
        .appt-grid {
            grid-template-columns: repeat(2,1fr);
            padding: 40px 24px 60px;
        }

        .appt-hero {
            padding: 60px 24px 40px;
        }

            .appt-hero::after {
                left: 24px;
                right: 24px;
            }
    }

    @@media (max-width: 600px) {
        .appt-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- HERO -->
<section class="appt-hero">
    <div>
        <h1>My <em>Appointments</em></h1>
        <p class="appt-hero-sub">Your upcoming bookings</p>
    </div>
    <div class="appt-hero-stat">
        <div class="num">@Model.Count()</div>
        <div class="lbl">Total bookings</div>
    </div>
</section>

<!-- GRID -->
<section class="appt-grid">

    @if (!Model.Any())
    {
        <div class="appt-empty">
            <div class="appt-empty-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <rect x="3" y="4" width="18" height="18" rx="3" stroke="#e91e8c" stroke-width="1.5" />
                    <path d="M3 9h18M8 2v4M16 2v4" stroke="#e91e8c" stroke-width="1.5" stroke-linecap="round" />
                </svg>
            </div>
            <h3>No bookings yet</h3>
            <p>You haven't booked any services yet</p>
            <a asp-controller="Categories" asp-action="Index" class="appt-empty-btn">
                Book Now
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                    <path d="M1.5 8.5L8.5 1.5M8.5 1.5H3M8.5 1.5V7" stroke="white" stroke-width="1.4" stroke-linecap="round" />
                </svg>
            </a>
        </div>
    }

    @foreach (var a in Model)
    {
        var local = a.StartUtc;
        var statusLower = a.Status.ToLower();

        <div class="appt-card">
            <div class="appt-card-bar bar-@statusLower"></div>
            <div class="appt-body">

                <span class="appt-status status-@statusLower">
                    <span class="status-dot"></span>
                    @a.Status
                </span>

                <h3 class="appt-service-name">@a.ServiceName</h3>
                <p class="appt-salon">
                    <svg width="11" height="11" viewBox="0 0 12 12" fill="none">
                        <path d="M6 1C4.07 1 2.5 2.57 2.5 4.5C2.5 7.25 6 11 6 11C6 11 9.5 7.25 9.5 4.5C9.5 2.57 7.93 1 6 1Z"
                              stroke="#9a7080" stroke-width="1.2" />
                        <circle cx="6" cy="4.5" r="1.2" stroke="#9a7080" stroke-width="1.2" />
                    </svg>
                    @a.SalonName
                </p>

                <div class="appt-divider"></div>

                <div class="appt-datetime">
                    <div class="appt-date-box">
                        <div class="day">@local.Day</div>
                        <div class="month">@local.ToString("MMM")</div>
                    </div>
                    <div class="appt-time-info">
                        <div class="time">@local.ToString("HH:mm")</div>
                        <div class="weekday">@local.ToString("dddd, yyyy")</div>
                    </div>
                </div>

                @if (a.Status == "Pending")
                {
                    <a asp-controller="Appointment"
                       asp-action="Cancel"
                       asp-route-id="@a.Id"
                       class="appt-cancel-btn">
                        <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                            <path d="M1 1l8 8M9 1L1 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                        </svg>
                        Cancel booking
                    </a>
                }

            </div>
        </div>
    }

</section>