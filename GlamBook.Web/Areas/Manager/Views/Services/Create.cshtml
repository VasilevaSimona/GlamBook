@{
    ViewBag.Categories = ViewBag.Categories;
}

<style>
    .create-wrap {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 80px 24px;
    }

    .create-card {
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 8px 48px rgba(45,26,36,0.1);
        padding: 52px 56px;
        max-width: 560px;
        width: 100%;
    }

    .create-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 44px;
        font-weight: 300;
        color: #2d1a24;
        line-height: 1;
        margin-bottom: 8px;
    }

        .create-title em {
            font-style: italic;
            color: #e91e8c;
        }

    .create-sub {
        font-size: 11px;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #9a7080;
        margin-bottom: 36px;
    }

    .form-label {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #9a7080;
        margin-bottom: 8px;
    }

    .form-control {
        border: 1px solid rgba(233,30,140,0.2);
        border-radius: 10px;
        padding: 12px 16px;
        font-family: 'Montserrat', sans-serif;
        font-size: 13px;
        background: #fdf7f4;
        transition: border-color 0.3s;
    }

        .form-control:focus {
            border-color: #e91e8c;
            box-shadow: 0 0 0 3px rgba(233,30,140,0.1);
            outline: none;
        }

    .submit-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #e91e8c;
        color: #fff;
        padding: 14px 32px;
        border-radius: 100px;
        font-family: 'Montserrat', sans-serif;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        border: none;
        cursor: pointer;
        transition: all 0.3s;
        width: 100%;
        margin-top: 8px;
    }

        .submit-btn:hover {
            background: #ff4db0;
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(233,30,140,0.4);
        }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 16px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #9a7080;
        text-decoration: none;
        transition: color 0.3s;
    }

        .back-link:hover {
            color: #e91e8c;
        }
</style>

<div class="create-wrap">
    <div class="create-card">
        <h1 class="create-title">Add <em>Service</em></h1>
        <p class="create-sub">New service for your salon</p>

        <form asp-area="Manager" asp-controller="Services" asp-action="Create" method="post">
            <div class="mb-4">
                <label class="form-label">Service Name</label>
                <input name="Name" class="form-control" placeholder="e.g. Hair Cut" />
            </div>
            <div class="mb-4">
                <label class="form-label">Price (€)</label>
                <input name="Price" type="number" step="0.01" class="form-control" placeholder="0.00" />
            </div>
            <div class="mb-4">
                <label class="form-label">Duration (minutes)</label>
                <input name="DurationInMinutes" type="number" class="form-control" placeholder="30" />
            </div>
            <div class="mb-4">
                <label class="form-label">Category</label>
                <select name="CategoryId" class="form-control">
                    @foreach (var cat in (IEnumerable<GlamBook.Domain.Entities.Category>)ViewBag.Categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
            </div>
            <button type="submit" class="submit-btn">Add Service</button>
        </form>

        <a asp-area="Manager" asp-controller="Services" asp-action="Index" class="back-link">← Back to Services</a>
    </div>
</div>