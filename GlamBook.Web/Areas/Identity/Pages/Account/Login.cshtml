@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — GlamBook</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background: #1a0a12;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

            /* Background glows */
            body::before {
                content: '';
                position: absolute;
                width: 600px;
                height: 600px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(233,30,140,0.18) 0%, transparent 70%);
                top: -200px;
                left: -200px;
                pointer-events: none;
            }

            body::after {
                content: '';
                position: absolute;
                width: 400px;
                height: 400px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(233,30,140,0.12) 0%, transparent 70%);
                bottom: -100px;
                right: -100px;
                pointer-events: none;
            }

        .login-wrap {
            display: grid;
            grid-template-columns: 1fr 1fr;
            max-width: 960px;
            width: 100%;
            margin: 24px;
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 40px 80px rgba(0,0,0,0.5);
            position: relative;
            z-index: 1;
        }

        /* LEFT PANEL */
        .login-left {
            background: linear-gradient(145deg, #2d0a1e, #1a0a12);
            padding: 64px 48px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            border-right: 1px solid rgba(233,30,140,0.15);
        }

            .login-left::before {
                content: '';
                position: absolute;
                width: 300px;
                height: 300px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(233,30,140,0.2) 0%, transparent 70%);
                bottom: -80px;
                right: -80px;
                pointer-events: none;
            }

        .login-brand {
            font-family: 'Montserrat', sans-serif;
            font-size: 22px;
            font-weight: 700;
            letter-spacing: 5px;
            color: #fff;
            text-decoration: none;
        }

            .login-brand span {
                color: #e91e8c;
            }

        .login-left-body {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 40px 0;
        }

        .login-left-eyebrow {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: #e91e8c;
            margin-bottom: 16px;
        }

        .login-left h2 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 52px;
            font-weight: 300;
            line-height: 1;
            color: #fff;
            margin-bottom: 20px;
        }

            .login-left h2 em {
                font-style: italic;
                color: #f48cb6;
            }

        .login-left p {
            font-size: 12px;
            color: rgba(255,255,255,0.4);
            line-height: 1.8;
            max-width: 260px;
        }

        .login-left-footer {
            font-size: 10px;
            color: rgba(255,255,255,0.2);
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        /* RIGHT PANEL */
        .login-right {
            background: #fdf7f4;
            padding: 64px 52px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .login-eyebrow {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: #e91e8c;
            margin-bottom: 12px;
        }

        .login-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 40px;
            font-weight: 300;
            color: #2d1a24;
            line-height: 1;
            margin-bottom: 6px;
        }

            .login-title em {
                font-style: italic;
                color: #e91e8c;
            }

        .login-sub {
            font-size: 12px;
            color: #9a7080;
            margin-bottom: 36px;
            letter-spacing: 0.5px;
        }

        .form-field {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #9a7080;
            margin-bottom: 8px;
        }

        .form-input {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid rgba(233,30,140,0.2);
            border-radius: 10px;
            font-family: 'Montserrat', sans-serif;
            font-size: 13px;
            background: #fff;
            color: #2d1a24;
            transition: border-color 0.3s, box-shadow 0.3s;
            outline: none;
        }

            .form-input:focus {
                border-color: #e91e8c;
                box-shadow: 0 0 0 3px rgba(233,30,140,0.1);
            }

            .form-input.input-validation-error {
                border-color: #dc3545;
            }

        .text-danger {
            color: #dc3545;
            font-size: 11px;
            margin-top: 4px;
            display: block;
        }

        .validation-summary-errors {
            background: rgba(220,53,69,0.08);
            border: 1px solid rgba(220,53,69,0.2);
            border-radius: 10px;
            padding: 12px 16px;
            margin-bottom: 20px;
            color: #dc3545;
            font-size: 12px;
        }

            .validation-summary-errors ul {
                margin: 0;
                padding-left: 16px;
            }

        .remember-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 28px;
        }

        .remember-label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 11px;
            color: #9a7080;
            cursor: pointer;
        }

            .remember-label input[type="checkbox"] {
                width: 15px;
                height: 15px;
                accent-color: #e91e8c;
                cursor: pointer;
            }

        .forgot-link {
            font-size: 11px;
            font-weight: 600;
            color: #e91e8c;
            text-decoration: none;
            letter-spacing: 1px;
            transition: color 0.3s;
        }

            .forgot-link:hover {
                color: #c0156e;
            }

        .submit-btn {
            width: 100%;
            padding: 14px;
            background: #e91e8c;
            color: #fff;
            border: none;
            border-radius: 100px;
            font-family: 'Montserrat', sans-serif;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s;
            margin-bottom: 24px;
        }

            .submit-btn:hover {
                background: #ff4db0;
                transform: translateY(-2px);
                box-shadow: 0 12px 32px rgba(233,30,140,0.4);
            }

        .login-divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(233,30,140,0.2), transparent);
            margin-bottom: 24px;
        }

        .login-links {
            text-align: center;
        }

            .login-links p {
                font-size: 12px;
                color: #9a7080;
                margin-bottom: 8px;
            }

            .login-links a {
                color: #e91e8c;
                text-decoration: none;
                font-weight: 600;
                transition: color 0.3s;
            }

                .login-links a:hover {
                    color: #c0156e;
                }

        @@media (max-width: 768px) {
            .login-wrap {
                grid-template-columns: 1fr;
                margin: 16px;
            }

            .login-left {
                display: none;
            }

            .login-right {
                padding: 48px 32px;
            }
        }
    </style>
</head>
<body>

    <div class="login-wrap">

        <!-- LEFT -->
        <div class="login-left">
            <a href="/" class="login-brand">GLAM<span>BOOK</span></a>

            <div class="login-left-body">
                <div class="login-left-eyebrow">Welcome back</div>
                <h2>Your Beauty<br><em>Journey</em><br>Awaits</h2>
                <p>Sign in to manage your appointments, explore salons, and discover the best beauty services near you.</p>
            </div>

            <div class="login-left-footer">© @DateTime.Now.Year GlamBook</div>
        </div>

        <!-- RIGHT -->
        <div class="login-right">
            <div class="login-eyebrow">Sign in</div>
            <h1 class="login-title">Welcome <em>Back</em></h1>
            <p class="login-sub">Enter your details to continue</p>

            <section>
                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

                    <div class="form-field">
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <input asp-for="Input.Email" class="form-input" autocomplete="username"
                               aria-required="true" placeholder="you@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-field">
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <input asp-for="Input.Password" class="form-input" autocomplete="current-password"
                               aria-required="true" placeholder="••••••••" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="remember-row">
                        <label asp-for="Input.RememberMe" class="remember-label">
                            <input asp-for="Input.RememberMe" type="checkbox" />
                            <span>Remember me</span>
                        </label>
                        <a asp-page="./ForgotPassword" class="forgot-link">Forgot password?</a>
                    </div>

                    <button type="submit" class="submit-btn">Sign In</button>

                    <div class="login-divider"></div>

                    <div class="login-links">
                        <p>Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create one</a></p>
                        <p><a asp-page="./ResendEmailConfirmation">Resend email confirmation</a></p>
                    </div>
                </form>
            </section>
        </div>

    </div>

    <partial name="_ValidationScriptsPartial" />
    <script>
        document.body.addEventListener('click', function(e) {
            if (!e.target.closest('.login-wrap')) {
                window.location.href = '/';
            }
        });
    </script>
</body>
</html>