@page
@model GlamBook.Web.Areas.Identity.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Log out";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Logout — GlamBook</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background: #1a0a12;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

            body::before {
                content: '';
                position: absolute;
                width: 600px;
                height: 600px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(233,30,140,0.15) 0%, transparent 70%);
                top: -200px;
                left: -200px;
                pointer-events: none;
            }

            body::after {
                content: '';
                position: absolute;
                width: 400px;
                height: 400px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(233,30,140,0.1) 0%, transparent 70%);
                bottom: -100px;
                right: -100px;
                pointer-events: none;
            }

        .logout-card {
            background: #fdf7f4;
            border-radius: 28px;
            padding: 64px 72px;
            max-width: 520px;
            width: 100%;
            margin: 24px;
            text-align: center;
            position: relative;
            z-index: 1;
            box-shadow: 0 40px 80px rgba(0,0,0,0.4);
        }

        .logout-brand {
            font-family: 'Montserrat', sans-serif;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 5px;
            color: #2d1a24;
            text-decoration: none;
            display: inline-block;
            margin-bottom: 40px;
        }

            .logout-brand span {
                color: #e91e8c;
            }

        .logout-divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(233,30,140,0.3), transparent);
            margin-bottom: 40px;
        }

        .logout-eyebrow {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: #e91e8c;
            margin-bottom: 16px;
        }

        .logout-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 52px;
            font-weight: 300;
            color: #2d1a24;
            line-height: 1;
            margin-bottom: 16px;
        }

            .logout-title em {
                font-style: italic;
                color: #e91e8c;
            }

        .logout-sub {
            font-size: 12px;
            color: #9a7080;
            line-height: 1.8;
            margin-bottom: 40px;
        }

        .logout-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 14px 32px;
            background: #e91e8c;
            color: #fff;
            border: none;
            border-radius: 100px;
            font-family: 'Montserrat', sans-serif;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s;
            margin-bottom: 16px;
        }

            .logout-btn:hover {
                background: #ff4db0;
                transform: translateY(-2px);
                box-shadow: 0 12px 32px rgba(233,30,140,0.4);
            }

        .home-link {
            display: inline-block;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #9a7080;
            text-decoration: none;
            transition: color 0.3s;
        }

            .home-link:hover {
                color: #e91e8c;
            }

        .success-icon {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: rgba(233,30,140,0.08);
            border: 1px solid rgba(233,30,140,0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 28px;
            font-size: 24px;
        }
    </style>
</head>
<body>

    <div class="logout-card">
        <a href="/" class="logout-brand">GLAM<span>BOOK</span></a>
        <div class="logout-divider"></div>

        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <div class="logout-eyebrow">Account</div>
            <h1 class="logout-title">Sign <em>Out</em></h1>
            <p class="logout-sub">Are you sure you want to log out of your GlamBook account?</p>

            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Page("/", new { area = "" })"
                  method="post">
                <button type="submit" class="logout-btn">Yes, Log Me Out</button>
            </form>

            <a href="/" class="home-link">← Stay & Go Home</a>
        }
        else
        {
            <div class="success-icon">✓</div>
            <div class="logout-eyebrow">See you soon</div>
            <h1 class="logout-title">Goodbye <em>For Now</em></h1>
            <p class="logout-sub">You've been successfully logged out. We hope to see you again soon.</p>
            <a href="/" class="logout-btn" style="text-decoration:none;">Back to Home</a>
        }
    </div>

</body>
</html>