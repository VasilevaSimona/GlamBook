@model GlamBook.Application.DTOs.CategoryDto

<style>
    .form-wrap {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 80px 24px;
    }

    .form-card {
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 8px 48px rgba(45,26,36,0.1);
        padding: 52px 56px;
        max-width: 480px;
        width: 100%;
    }

    .form-eyebrow {
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: #e91e8c;
        margin-bottom: 12px;
    }

    .form-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 44px;
        font-weight: 300;
        color: #2d1a24;
        line-height: 1;
        margin-bottom: 8px;
    }

        .form-title em {
            font-style: italic;
            color: #e91e8c;
        }

    .form-sub {
        font-size: 11px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #9a7080;
        margin-bottom: 36px;
    }

    .form-divider {
        height: 1px;
        background: linear-gradient(90deg, transparent, #f48cb6, transparent);
        margin-bottom: 32px;
    }

    .field-label {
        display: block;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #9a7080;
        margin-bottom: 8px;
    }

    .field-input {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid rgba(233,30,140,0.2);
        border-radius: 10px;
        font-family: 'Montserrat', sans-serif;
        font-size: 13px;
        background: #fdf7f4;
        color: #2d1a24;
        transition: border-color 0.3s, box-shadow 0.3s;
        outline: none;
    }

        .field-input:focus {
            border-color: #e91e8c;
            box-shadow: 0 0 0 3px rgba(233,30,140,0.1);
        }

    .text-danger {
        color: #dc3545;
        font-size: 11px;
        margin-top: 4px;
        display: block;
    }

    .submit-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #e91e8c;
        color: #fff;
        padding: 14px 32px;
        border-radius: 100px;
        font-family: 'Montserrat', sans-serif;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        border: none;
        cursor: pointer;
        transition: all 0.3s;
        width: 100%;
        margin-top: 24px;
    }

        .submit-btn:hover {
            background: #ff4db0;
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(233,30,140,0.4);
        }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 16px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #9a7080;
        text-decoration: none;
        transition: color 0.3s;
    }

        .back-link:hover {
            color: #e91e8c;
        }
</style>

<div class="form-wrap">
    <div class="form-card">
        <div class="form-eyebrow">Admin — Categories</div>
        <h1 class="form-title">New <em>Category</em></h1>
        <p class="form-sub">Add a new beauty category</p>
        <div class="form-divider"></div>

        <form method="post">
            <div style="margin-bottom: 20px;">
                <label class="field-label">Category Name</label>
                <input asp-for="Name" class="field-input" placeholder="e.g. Hair, Face, Body" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <button type="submit" class="submit-btn">Create Category</button>
        </form>

        <a asp-action="Index" class="back-link">← Back to Categories</a>
    </div>
</div>