@model IEnumerable<GlamBook.Application.DTOs.CategoryDto>

<style>
    .admin-hero {
        padding: 48px 48px 32px;
        border-bottom: 1px solid rgba(233,30,140,0.12);
        margin-bottom: 40px;
    }

        .admin-hero h1 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 52px;
            font-weight: 300;
            color: #2d1a24;
            line-height: 1;
        }

            .admin-hero h1 em {
                font-style: italic;
                color: #e91e8c;
            }

    .admin-hero-sub {
        font-size: 11px;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #9a7080;
        margin-top: 8px;
    }

    .admin-wrap {
        padding: 0 48px 80px;
    }

    .admin-add-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #e91e8c;
        color: #fff;
        padding: 12px 28px;
        border-radius: 100px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        text-decoration: none;
        transition: all 0.3s;
        margin-bottom: 32px;
    }

        .admin-add-btn:hover {
            background: #ff4db0;
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(233,30,140,0.4);
        }

    .admin-table-wrap {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 4px 24px rgba(45,26,36,0.06);
        overflow: hidden;
    }

    .admin-table-header {
        padding: 20px 28px;
        border-bottom: 1px solid rgba(233,30,140,0.08);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .admin-table-title {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #9a7080;
    }

    .admin-table-count {
        font-family: 'Cormorant Garamond', serif;
        font-size: 22px;
        font-weight: 300;
        color: #e91e8c;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead th {
        padding: 14px 20px;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #9a7080;
        background: #fdf7f4;
        text-align: left;
        border-bottom: 1px solid rgba(233,30,140,0.08);
    }

        thead th:last-child {
            text-align: right;
        }

    tbody tr {
        border-bottom: 1px solid rgba(233,30,140,0.06);
        transition: background 0.2s;
    }

        tbody tr:hover {
            background: #fdf7f4;
        }

        tbody tr:last-child {
            border-bottom: none;
        }

    tbody td {
        padding: 18px 20px;
        font-size: 13px;
        color: #2d1a24;
        vertical-align: middle;
    }

    .td-name {
        font-family: 'Cormorant Garamond', serif;
        font-size: 22px;
        font-weight: 400;
        color: #2d1a24;
    }

    .action-btns {
        display: flex;
        gap: 8px;
    }

    .btn-edit {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 16px;
        border-radius: 100px;
        border: 1px solid rgba(233,30,140,0.3);
        background: rgba(233,30,140,0.04);
        font-family: 'Montserrat', sans-serif;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #e91e8c;
        text-decoration: none;
        transition: all 0.2s;
    }

        .btn-edit:hover {
            background: #e91e8c;
            border-color: #e91e8c;
            color: #fff;
        }

    .btn-delete {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 16px;
        border-radius: 100px;
        border: 1px solid rgba(220,53,69,0.3);
        background: rgba(220,53,69,0.04);
        font-family: 'Montserrat', sans-serif;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #dc3545;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-delete:hover {
            background: #dc3545;
            border-color: #dc3545;
            color: #fff;
        }

    .empty-row td {
        text-align: center;
        padding: 60px 20px;
        font-family: 'Cormorant Garamond', serif;
        font-size: 22px;
        font-style: italic;
        color: #9a7080;
    }
</style>

<div class="admin-hero">
    <h1>Manage <em>Categories</em></h1>
    <p class="admin-hero-sub">Create and manage beauty categories</p>
</div>

<div class="admin-wrap">
    <a asp-action="Create" class="admin-add-btn">
        + Add Category
    </a>

    <div class="admin-table-wrap">
        <div class="admin-table-header">
            <span class="admin-table-title">All Categories</span>
            <span class="admin-table-count">@Model.Count()</span>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr class="empty-row">
                        <td colspan="2">No categories yet</td>
                    </tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td><div class="td-name">@c.Name</div></td>
                        <td style="text-align: right;">
                            <div class="action-btns" style="justify-content: flex-end;">
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn-edit">✎ Edit</a>
                                <form asp-action="Delete" method="post" style="display:inline">
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit" class="btn-delete">✕ Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>